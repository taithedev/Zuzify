# Public Neon Auth URL, no private keys in Vite/Vercel client environment variables.
VITE_NEON_AUTH_URL=https://ep-rough-recipe-bcjp6wq7.neonauth.c-16.us-east-1.aws.neon.tech/neondb/auth

# Server-side Vercel environment variable. Set this to the bot's WORKING
# public HTTPS origin (the /health URL must respond successfully).
# Do not prefix this with VITE_ or put an auth token/DB connection in it.
BOT_LINK_API_URL=https://your-bot-subdomain.apps.bot-hosting.cloud

# Server-only communication center. Apply db/communications.sql first.
COMMUNICATIONS_DATABASE_URL=
COMMUNICATIONS_JWT_ISSUER=https://ep-rough-recipe-bcjp6wq7.neonauth.c-16.us-east-1.aws.neon.tech/neondb/auth
COMMUNICATIONS_JWT_AUDIENCE=
RESEND_API_KEY=
# Configure a receiving mailbox or forwarding address before enabling replies.
ZUZIFY_SUPPORT_INBOX=
# JSON map of app name to distinct random secret, server-only.
ZUZIFY_APP_EVENT_KEYS=
ZUZIFY_COMMUNICATIONS_ADMIN_KEY=
CRON_SECRET=
